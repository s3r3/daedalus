# Environment configuration. Copy to .env and fill in values.
# LLM provider (OpenAI-compatible).
LLM_BASE_URL=https://llm.ayid.cc.cd/v1
LLM_API_KEY=
LLM_MODEL=

# Web backend.
DAEDALUS_HOST=127.0.0.1
DAEDALUS_PORT=3080

# Persistence root for task event logs and task state.
DAEDALUS_HOME=.daedalus
