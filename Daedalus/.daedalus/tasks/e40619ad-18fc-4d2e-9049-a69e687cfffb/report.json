  "diff": "--- a/jojo/index.html\n+++ b/jojo/index.html\n@@ +79 -0 @@\n+<!DOCTYPE html>\n+<html lang=\"id\">\n+<head>\n+<meta charset=\"UTF-8\">\n+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n+<title>PT Contoh — Company Profile</title>\n+<style>\n+  :root { --brand:#1a5fb4; --ink:#1f2937; --bg:#f8fafc; }\n+  * { box-sizing:border-box; margin:0; padding:0; }\n+  body { font-family:system-ui,sans-serif; color:var(--ink); background:var(--bg); line-height:1.6; }\n+  header { background:var(--brand); color:#fff; padding:1rem 2rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; }\n+  header h1 { font-size:1.25rem; }\n+  nav a { color:#fff; text-decoration:none; margin-left:1.25rem; font-size:.95rem; }\n+  nav a:hover { text-decoration:underline; }\n+  section { max-width:1000px; margin:0 auto; padding:3rem 1.5rem; }\n+  h2 { color:var(--brand); margin-bottom:1rem; }\n+  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:1.25rem; }\n+  .card { background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:1.25rem; }\n+  .card h3 { font-size:1.05rem; margin-bottom:.35rem; }\n+  .card .price { color:var(--brand); font-weight:600; }\n+  .card p { font-size:.9rem; color:#6b7280; }\n+  .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1rem; text-align:center; }\n+  .stats div { background:#fff; border-radius:8px; padding:1.25rem; border:1px solid #e5e7eb; }\n+  .stats strong { display:block; font-size:1.75rem; color:var(--brand); }\n+  footer { background:var(--ink); color:#d1d5db; text-align:center; padding:1.5rem; font-size:.9rem; }\n+</style>\n+</head>\n+<body>\n+<header>\n+  <h1>PT Contoh</h1>\n+  <nav>\n+    <a href=\"#tentang\">Tentang</a>\n+    <a href=\"#produk\">Produk</a>\n+    <a href=\"#kontak\">Kontak</a>\n+  </nav>\n+</header>\n+\n+<section id=\"tentang\">\n+  <h2>Tentang Kami</h2>\n+  <p>PT Contoh adalah perusahaan yang bergerak di bidang penyediaan produk berkualitas untuk kebutuhan bisnis dan rumah tangga. Berdiri sejak 2010, kami melayani ribuan pelanggan di seluruh Indonesia dengan komitmen kualitas dan pelayanan terbaik.</p>\n+</section>\n+\n+<section>\n+  <h2>Keunggulan</h2>\n+  <div class=\"stats\">\n+    <div><strong>14+</strong>Tahun pengalaman</div>\n+    <div><strong>5000+</strong>Pelanggan aktif</div>\n+    <div><strong>34</strong>Kota jangkauan</div>\n+    <div><strong>99%</strong>Kepuasan pelanggan</div>\n+  </div>\n+</section>\n+\n+<section id=\"produk\">\n+  <h2>Katalog Produk</h2>\n+  <div class=\"grid\" id=\"katalog\"></div>\n+</section>\n+\n+<section id=\"kontak\">\n+  <h2>Kontak</h2>\n+  <p>Jl. Contoh No. 123, Jakarta<br>Email: info@ptcontoh.co.id<br>Telp: (021) 555-0123</p>\n+</section>\n+\n+<footer>© 2024 PT Contoh. Hak cipta dilindungi.</footer>\n+\n+<script>\n+const produk = [\n+  { nama: \"Produk A\", harga: \"Rp 150.000\", desc: \"Produk unggulan untuk kebutuhan harian.\" },\n+  { nama: \"Produk B\", harga: \"Rp 275.000\", desc: \"Bahan premium dengan daya tahan tinggi.\" },\n+  { nama: \"Produk C\", harga: \"Rp 99.000\", desc: \"Pilihan ekonomis untuk usaha kecil.\" },\n+  { nama: \"Produk D\", harga: \"Rp 450.000\", desc: \"Solusi lengkap untuk kebutuhan kantor.\" },\n+  { nama: \"Produk E\", harga: \"Rp 320.000\", desc: \"Desain modern, cocok untuk segala usia.\" },\n+  { nama: \"Produk F\", harga: \"Rp 75.000\", desc: \"Aksesori praktis dengan harga terjangkau.\" }\n+];\n+document.getElementById(\"katalog\").innerHTML = produk.map(p =>\n+  `<article class=\"card\"><h3>${p.nama}</h3><div class=\"price\">${p.harga}</div><p>${p.desc}</p></article>`\n+).join(\"\");\n+</script>\n+</body>\n+</html>\n",
